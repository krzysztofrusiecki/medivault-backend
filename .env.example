# Application Environment
NODE_ENV=development

# Server Configuration
PORT=3000

# Database Configuration
# Development: PostgreSQL local instance
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medivault?schema=public"

# Testing: Uses in-memory SQLite (configured in jest.config.js)
# DATABASE_URL=file:memdb1?mode=memory&cache=shared

# JWT Configuration
ACCESS_TOKEN_SECRET="your-secret-key-minimum-32-characters-long"
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:4200
