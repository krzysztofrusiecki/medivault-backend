// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication and profile management
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  gender       Gender?
  birthDate    DateTime?
  role         Role      @default(USER)
  labId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lab         Lab?        @relation(fields: [labId], references: [id])
  testBatches TestBatch[]

  @@map("users")
}

// A registered laboratory organization. LAB_ADMIN staff are attached to
// exactly one Lab by a SUPER_ADMIN via User.labId.
model Lab {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff   User[]
  batches TestBatch[]

  @@map("labs")
}

// Gender enum for user profile
enum Gender {
  MALE
  FEMALE
}

enum Role {
  USER
  LAB_ADMIN
  SUPER_ADMIN
}

model Analyte {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  valueType AnalyteValueType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  units           AnalyteUnit[]
  testResults     TestResult[]
  referenceRanges ReferenceRange[]

  @@map("analytes")
}

enum AnalyteValueType {
  NUMERIC
  TEXT
}

model AnalyteUnit {
  id                String  @id @default(cuid())
  analyteId         String
  unit              String
  isCanonical       Boolean @default(false)
  factorToCanonical Decimal @db.Decimal(20, 10) // value * factor + offset => canonical
  offset            Decimal @default(0) @db.Decimal(20, 10)

  analyte     Analyte      @relation(fields: [analyteId], references: [id])
  testResults TestResult[]

  @@unique([analyteId, unit])
  @@map("analyte_units")
}

model ReferenceRange {
  id        String   @id @default(cuid())
  analyteId String
  label     String
  gender    Gender?
  minAge    Int?
  maxAge    Int?
  minValue  Decimal? @db.Decimal(20, 10)
  maxValue  Decimal? @db.Decimal(20, 10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analyte Analyte @relation(fields: [analyteId], references: [id])

  @@index([analyteId])
  @@map("reference_ranges")
}

model TestResult {
  id        String @id @default(cuid())
  analyteId String
  batchId   String

  analyteUnitId  String?
  valueRaw       Decimal? @db.Decimal(20, 10)
  value          Decimal? @db.Decimal(20, 10)
  factorSnapshot Decimal? @db.Decimal(20, 10)
  offsetSnapshot Decimal? @db.Decimal(20, 10)

  valueText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analyte     Analyte      @relation(fields: [analyteId], references: [id])
  analyteUnit AnalyteUnit? @relation(fields: [analyteUnitId], references: [id])
  batch       TestBatch    @relation(fields: [batchId], references: [id])

  @@index([batchId, analyteId])
  @@map("test_results")
}

// A group of test results from a single lab visit — either self-reported by
// the patient (labLabel, free text) or submitted by a registered Lab
// (labId). Exactly one of labId/labLabel is set, enforced at the app layer.
model TestBatch {
  id       String  @id @default(cuid())
  userId   String
  labId    String?
  labLabel String?

  sampleDate DateTime
  notes      String?
  status     TestBatchStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  lab  Lab? @relation(fields: [labId], references: [id])

  results TestResult[]

  @@index([userId, status])
  @@index([userId, sampleDate])
  @@map("test_batches")
}

enum TestBatchStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  DECLINED
}
