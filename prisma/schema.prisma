// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication and profile management
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  gender       Gender?
  birthDate    DateTime?
  role         Role      @default(USER)
  labId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lab         Lab?         @relation(fields: [labId], references: [id])
  testResults TestResult[]

  @@map("users")
}

// A registered laboratory organization. LAB_ADMIN staff are attached to
// exactly one Lab by a SUPER_ADMIN via User.labId.
model Lab {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff User[]

  @@map("labs")
}

// Gender enum for user profile
enum Gender {
  MALE
  FEMALE
}

enum Role {
  USER
  LAB_ADMIN
  SUPER_ADMIN
}

model Analyte {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  valueType AnalyteValueType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  units       AnalyteUnit[]
  testResults TestResult[]

  @@map("analytes")
}

enum AnalyteValueType {
  NUMERIC
  TEXT
}

model AnalyteUnit {
  id                String  @id @default(cuid())
  analyteId         String
  unit              String
  isCanonical       Boolean @default(false)
  factorToCanonical Decimal @db.Decimal(20, 10) // value * factor + offset => canonical
  offset            Decimal @default(0) @db.Decimal(20, 10)

  analyte     Analyte      @relation(fields: [analyteId], references: [id])
  testResults TestResult[]

  @@unique([analyteId, unit])
  @@map("analyte_units")
}

model TestResult {
  id        String @id @default(cuid())
  userId    String
  analyteId String

  analyteUnitId  String?
  valueRaw       Decimal? @db.Decimal(20, 10)
  value          Decimal? @db.Decimal(20, 10)
  factorSnapshot Decimal? @db.Decimal(20, 10)
  offsetSnapshot Decimal? @db.Decimal(20, 10)

  valueText String?

  sampleDate DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  analyte     Analyte      @relation(fields: [analyteId], references: [id])
  analyteUnit AnalyteUnit? @relation(fields: [analyteUnitId], references: [id])

  @@index([userId, analyteId, sampleDate])
  @@map("test_results")
}
